# 複製成 .env 後填入。.env 已列入 .gitignore，絕不可 commit。
# APP_HOST 只接受 loopback 位址（127.0.0.1 / localhost / ::1），填其他值會啟動失敗。
APP_HOST=127.0.0.1
APP_PORT=3000

# 階段 4 才需要。使用專用 WordPress 使用者（Author/Editor，不要用 Administrator）
# 的 Application Password，不要填主要登入密碼。
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# 發到哪些內容類型不在這裡設定：把 config/publish-targets.example.json 複製成
# config/publish-targets.json（本機檔，不進 Git）。作者站台的設定在 config/examples/remusplus.json。

# 選填：silent | error | warn | info | debug | trace
LOG_LEVEL=info
